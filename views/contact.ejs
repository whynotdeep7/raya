<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/header') %></head>
<body class="bg-ivory min-h-screen flex flex-col">

<main class="flex-1 max-w-2xl mx-auto px-4 sm:px-6 py-16 w-full">
  <div class="mb-10">
    <h1 class="text-4xl font-serif font-bold text-charcoal mb-2">Get in touch</h1>
    <p class="text-text-muted text-sm">Have a question or feedback? We'd love to hear from you.</p>
  </div>

  <% if (success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 rounded-2xl p-5 mb-6 flex items-center gap-3">
      <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div>
        <p class="font-medium text-sm">Message sent!</p>
        <p class="text-xs text-green-600 mt-0.5">We'll get back to you within 24 hours.</p>
      </div>
    </div>
  <% } %>

  <div class="bg-white rounded-2xl border border-warm-border/50 shadow-soft p-7">
    <form action="/contact" method="POST" class="space-y-5">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="raya-label">Your name</label>
          <input type="text" name="name" required placeholder="Jane Doe" class="raya-input">
        </div>
        <div>
          <label class="raya-label">Email address</label>
          <input type="email" name="email" required placeholder="you@example.com" class="raya-input">
        </div>
      </div>
      <div>
        <label class="raya-label">Message</label>
        <textarea name="message" required rows="5" placeholder="Tell us what's on your mind..." class="raya-input" style="resize:none;padding-top:10px"></textarea>
      </div>
      <button type="submit" class="btn-primary">Send message</button>
    </form>
  </div>

  <!-- Info cards -->
  <div class="grid grid-cols-2 gap-4 mt-6">
    <div class="bg-white rounded-xl border border-warm-border/50 p-5">
      <div class="w-9 h-9 rounded-xl bg-blush flex items-center justify-center mb-3">
        <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
      <p class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-1">Email</p>
      <p class="text-sm text-charcoal">hello@raya.app</p>
    </div>
    <div class="bg-white rounded-xl border border-warm-border/50 p-5">
      <div class="w-9 h-9 rounded-xl bg-blush flex items-center justify-center mb-3">
        <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <p class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-1">Response time</p>
      <p class="text-sm text-charcoal">Within 24 hours</p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
