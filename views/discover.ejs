<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/header') %></head>
<body class="bg-ivory min-h-screen flex flex-col">

<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
  <div class="flex flex-col lg:flex-row gap-8">

    <!-- Sidebar filters -->
    <aside class="w-full lg:w-64 shrink-0">
      <div class="sticky top-20">
        <h1 class="text-2xl font-serif font-bold text-charcoal mb-1">Discover</h1>
        <p class="text-text-muted text-sm mb-6" id="resultCount">Loading profiles...</p>
        <div class="bg-white rounded-2xl p-5 border border-warm-border/50 shadow-soft">
          <div class="flex items-center justify-between mb-5">
            <h2 class="font-serif font-bold text-charcoal">Filters</h2>
            <button id="resetBtn" class="text-[11px] font-semibold uppercase tracking-wider text-gold hover:text-gold-dark transition-colors">Reset</button>
          </div>

          <!-- Search -->
          <div class="mb-5">
            <label class="raya-label">Search</label>
            <input type="text" id="filterSearch" placeholder="Name or profession..." class="raya-input" style="padding-bottom:8px">
          </div>

          <!-- Gender -->
          <div class="mb-5">
            <label class="raya-label">Gender</label>
            <select id="filterGender" class="raya-input" style="cursor:pointer;padding-bottom:8px">
              <option value="">Any</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <!-- Age -->
          <div class="mb-5">
            <label class="raya-label">Age range</label>
            <div class="flex gap-2 mt-1">
              <input type="number" id="filterMinAge" placeholder="18" min="18" max="80" class="raya-input" style="text-align:center;padding-bottom:8px">
              <span class="self-end pb-2 text-text-muted text-sm">–</span>
              <input type="number" id="filterMaxAge" placeholder="50" min="18" max="100" class="raya-input" style="text-align:center;padding-bottom:8px">
            </div>
          </div>

          <!-- Location -->
          <div class="mb-6">
            <label class="raya-label">Location</label>
            <input type="text" id="filterLocation" placeholder="City or region" class="raya-input" style="padding-bottom:8px">
          </div>

          <button id="applyBtn" class="btn-primary" style="font-size:0.8rem;padding:10px">Apply Filters</button>
        </div>
      </div>
    </aside>

    <!-- Main grid -->
    <div class="flex-1">
      <div id="profileGrid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5"></div>

      <!-- Loading skeletons -->
      <div id="loadingSkeleton" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
        <% for(let i=0;i<6;i++) { %>
        <div class="profile-card">
          <div class="skeleton aspect-[4/5]"></div>
          <div class="p-4 space-y-2">
            <div class="skeleton h-4 w-3/4 rounded"></div>
            <div class="skeleton h-3 w-1/2 rounded"></div>
          </div>
        </div>
        <% } %>
      </div>

      <!-- Pagination -->
      <div class="mt-8 flex justify-center gap-3" id="pagination" style="display:none!important"></div>
    </div>
  </div>
</main>

<div id="toast"></div>
<%- include('partials/footer') %>

<script>
let currentPage = 1;
let totalPages = 1;

function getFilters() {
  return {
    search:   document.getElementById('filterSearch').value.trim(),
    gender:   document.getElementById('filterGender').value,
    minAge:   document.getElementById('filterMinAge').value,
    maxAge:   document.getElementById('filterMaxAge').value,
    location: document.getElementById('filterLocation').value.trim(),
  };
}

function avatarHTML(user) {
  const letter = user.firstName.charAt(0).toUpperCase();
  // Check if profilePic is a valid, non-empty string
  if (user.profilePic && typeof user.profilePic === 'string' && user.profilePic.trim().length > 0) {
    const picSrc = user.profilePic.startsWith('http')
      ? user.profilePic
      : `/uploads/${String(user.profilePic).split(/[\\/]/).pop()}`;
    return `
      <img src="${picSrc}" class="w-full h-full object-cover" alt="" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
      <div style="display:none;" class="w-full h-full flex items-center justify-center bg-blush">
        <span class="font-serif font-bold text-6xl text-gold">${letter}</span>
      </div>
    `;
  } else {
    return `<div class="w-full h-full flex items-center justify-center bg-blush">
      <span class="font-serif font-bold text-6xl text-gold">${letter}</span>
    </div>`;
  }
}

function relationBtn(user) {
  if (user.relationshipStatus === 'friend') {
    return `<span class="btn-add-friend friend w-full justify-center" style="pointer-events:none">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      Connected
    </span>`;
  }
  if (user.relationshipStatus === 'pending') {
    return `<span class="btn-add-friend pending w-full justify-center" style="pointer-events:none">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Pending
    </span>`;
  }
  return `<button class="btn-add-friend w-full justify-center" onclick="sendRequest('${user._id}', this)">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Connect
  </button>`;
}

async function loadProfiles(page = 1) {
  currentPage = page;
  const f = getFilters();
  const params = new URLSearchParams({ page, ...f });
  document.getElementById('loadingSkeleton').style.display = 'grid';
  document.getElementById('profileGrid').innerHTML = '';

  try {
    const res  = await fetch('/api/users?' + params);
    const data = await res.json();
    totalPages = data.pages || 1;

    document.getElementById('loadingSkeleton').style.display = 'none';
    document.getElementById('resultCount').textContent =
      `${data.total} ${data.total === 1 ? 'person' : 'people'} found`;

    if (data.users.length === 0) {
      document.getElementById('profileGrid').innerHTML = `
        <div class="col-span-3 py-20 text-center text-text-muted">
          <svg class="w-12 h-12 mx-auto mb-4 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <p class="text-sm">No profiles match your filters.</p>
        </div>`;
      return;
    }

    const grid = document.getElementById('profileGrid');
    data.users.forEach(user => {
      const card = document.createElement('div');
      card.className = 'profile-card';
      card.id = 'card-' + user._id;
      card.innerHTML = `
        <a href="/user/${user._id}" class="block relative aspect-[4/5] overflow-hidden">
          ${avatarHTML(user)}
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <h3 class="text-white font-serif font-bold text-lg leading-tight">
              ${user.firstName}${user.age ? ', ' + user.age : ''}
            </h3>
            <p class="text-white/75 text-xs mt-0.5">
              ${[user.profession, user.location].filter(Boolean).join(' · ')}
            </p>
          </div>
        </a>
        <div class="p-4">
          <p class="profile-card-bio text-sm text-text-muted leading-relaxed line-clamp-2">${user.bio || ''}</p>
          <div class="profile-card-action">
            ${relationBtn(user)}
          </div>
        </div>`;
      grid.appendChild(card);
    });

    renderPagination();
  } catch (err) {
    console.error(err);
    document.getElementById('loadingSkeleton').style.display = 'none';
  }
}

function renderPagination() {
  const pg = document.getElementById('pagination');
  if (totalPages <= 1) { pg.style.display = 'none'; return; }
  pg.style.display = 'flex';
  pg.innerHTML = '';
  for (let i = 1; i <= totalPages; i++) {
    const btn = document.createElement('button');
    btn.textContent = i;
    btn.className = i === currentPage
      ? 'w-9 h-9 rounded-full bg-charcoal text-white text-sm font-medium'
      : 'w-9 h-9 rounded-full border border-warm-border text-charcoal text-sm hover:border-gold hover:text-gold transition-colors';
    btn.onclick = () => loadProfiles(i);
    pg.appendChild(btn);
  }
}

async function sendRequest(toId, btn) {
  btn.disabled = true;
  btn.textContent = 'Sending...';
  try {
    const res = await fetch('/api/friends/request', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ toId }),
    });
    const data = await res.json();
    if (res.ok) {
      btn.outerHTML = `<span class="btn-add-friend pending w-full justify-center" style="pointer-events:none">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Pending
      </span>`;
      showToast('Request sent!');
    } else {
      showToast(data.error || 'Could not send request');
      btn.disabled = false;
      btn.textContent = 'Connect';
    }
  } catch {
    btn.disabled = false;
    btn.textContent = 'Connect';
  }
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

document.getElementById('applyBtn').addEventListener('click', () => loadProfiles(1));
document.getElementById('resetBtn').addEventListener('click', () => {
  document.getElementById('filterSearch').value = '';
  document.getElementById('filterGender').value = '';
  document.getElementById('filterMinAge').value = '';
  document.getElementById('filterMaxAge').value = '';
  document.getElementById('filterLocation').value = '';
  loadProfiles(1);
});
document.getElementById('filterSearch').addEventListener('keydown', e => { if (e.key === 'Enter') loadProfiles(1); });

loadProfiles(1);
</script>
</body>
</html>
