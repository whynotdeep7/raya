<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/header') %>
</head>
<body class="bg-ivory min-h-screen flex flex-col">

<% if (currentUser) { %>
<!-- ════════════════════════════════════════════════
     DASHBOARD (logged in)
════════════════════════════════════════════════ -->
<main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">

  <!-- Top bar -->
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-serif font-bold text-charcoal"><%= typeof greeting !== 'undefined' && greeting ? greeting : 'Good evening' %>, <%= currentUser.firstName %></h1>
      <p class="text-text-muted text-sm mt-1">Here's what's happening today.</p>
    </div>
    <a href="/discover" class="btn-primary" style="width:auto;padding:10px 22px;text-decoration:none;">
      Discover people
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Left: Friend requests -->
    <div class="lg:col-span-2 space-y-6">

      <% if (pendingRequests.length > 0) { %>
      <section>
        <h2 class="text-lg font-serif font-bold text-charcoal mb-4">
          Friend Requests
          <span class="ml-2 text-xs font-sans font-semibold bg-gold text-white rounded-full px-2 py-0.5"><%= pendingRequests.length %></span>
        </h2>
        <div class="space-y-3">
          <% pendingRequests.forEach(req => { %>
          <div class="bg-white rounded-2xl p-4 border border-warm-border/50 flex items-center gap-4" id="req-<%= req.from._id %>">
            <a href="/user/<%= req.from._id %>">
              <% if (req.from.profilePic) { %>
                <img src="<%= req.from.profilePic.startsWith('http') ? req.from.profilePic : '/uploads/' + req.from.profilePic.split(/[\\/]/).pop() %>" class="w-12 h-12 rounded-full object-cover" alt="" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div style="display:none;" class="w-12 h-12 rounded-full bg-blush flex items-center justify-center font-serif font-bold text-gold text-lg"><%= req.from.firstName.charAt(0) %></div>
              <% } else { %>
                <div class="w-12 h-12 rounded-full bg-blush flex items-center justify-center font-serif font-bold text-gold text-lg"><%= req.from.firstName.charAt(0) %></div>
              <% } %>
            </a>
            <div class="flex-1 min-w-0">
              <p class="font-medium text-charcoal text-sm"><a href="/user/<%= req.from._id %>" class="hover:text-gold transition-colors"><%= req.from.firstName %> <%= req.from.lastName %></a></p>
              <p class="text-xs text-text-muted mt-0.5"><%= req.from.profession || '' %> <% if (req.from.location) { %>&middot; <%= req.from.location %><% } %></p>
            </div>
            <div class="flex gap-2 shrink-0">
              <button onclick="acceptRequest('<%= req.from._id %>')"
                class="px-4 py-1.5 rounded-full bg-charcoal text-white text-xs font-medium hover:bg-gold transition-colors duration-200">
                Accept
              </button>
              <button onclick="rejectRequest('<%= req.from._id %>')"
                class="px-4 py-1.5 rounded-full border border-warm-border text-text-muted text-xs font-medium hover:border-red-300 hover:text-red-500 transition-colors duration-200">
                Decline
              </button>
            </div>
          </div>
          <% }) %>
        </div>
      </section>
      <% } %>

      <!-- Friends list -->
      <section>
        <h2 class="text-lg font-serif font-bold text-charcoal mb-4">
          My Connections
          <span class="text-sm font-sans font-normal text-text-muted ml-2"><%= friends.length %> friends</span>
        </h2>
        <% if (friends.length === 0) { %>
          <div class="bg-white rounded-2xl border border-warm-border/50 p-10 text-center">
            <svg class="w-12 h-12 mx-auto mb-4 text-warm-border" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p class="text-text-muted text-sm mb-4">You haven't connected with anyone yet.</p>
            <a href="/discover" class="text-gold font-medium text-sm hover:text-gold-dark transition-colors">Start discovering people →</a>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <% friends.forEach(friend => { %>
            <a href="/user/<%= friend._id %>" class="bg-white rounded-xl border border-warm-border/50 p-4 flex items-center gap-3 hover:border-gold/40 transition-colors duration-200 group" style="text-decoration:none;">
              <div class="relative">
                <% if (friend.profilePic) { %>
                  <img src="<%= friend.profilePic.startsWith('http') ? friend.profilePic : '/uploads/' + friend.profilePic.split(/[\\/]/).pop() %>" class="w-11 h-11 rounded-full object-cover" alt="" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                  <div style="display:none;" class="w-11 h-11 rounded-full bg-blush flex items-center justify-center font-serif font-bold text-gold"><%= friend.firstName.charAt(0) %></div>
                <% } else { %>
                  <div class="w-11 h-11 rounded-full bg-blush flex items-center justify-center font-serif font-bold text-gold"><%= friend.firstName.charAt(0) %></div>
                <% } %>
                <% if (friend.isOnline) { %>
                  <span class="online-dot"></span>
                <% } %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-sm text-charcoal group-hover:text-gold transition-colors truncate"><%= friend.firstName %> <%= friend.lastName %></p>
                <p class="text-xs text-text-muted truncate mt-0.5"><%= friend.profession || friend.location || 'Raya member' %></p>
              </div>

            </a>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>

    <!-- Right: Quick links -->
    <div class="space-y-4">
      <div class="bg-white rounded-2xl border border-warm-border/50 p-6">
        <h3 class="font-serif font-bold text-charcoal mb-4">Quick Actions</h3>
        <div class="space-y-3">
          <a href="/discover" class="flex items-center gap-3 text-sm text-text-muted hover:text-charcoal transition-colors group">
            <div class="w-9 h-9 rounded-xl bg-blush flex items-center justify-center group-hover:bg-gold/10 transition-colors">
              <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/></svg>
            </div>
            Discover people
          </a>

          <a href="/profile" class="flex items-center gap-3 text-sm text-text-muted hover:text-charcoal transition-colors group">
            <div class="w-9 h-9 rounded-xl bg-blush flex items-center justify-center group-hover:bg-gold/10 transition-colors">
              <svg class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
            Edit my profile
          </a>
        </div>
      </div>

      <!-- Profile completeness -->
      <div class="bg-charcoal rounded-2xl p-6 text-white">
        <p class="text-xs uppercase tracking-widest text-white/50 mb-2">Profile</p>
        <h3 class="font-serif font-bold text-lg mb-1">Make it shine</h3>
        <p class="text-xs text-white/60 mb-4">A complete profile gets 3× more connections.</p>
        <a href="/profile" class="inline-block text-xs font-medium text-gold hover:text-gold-light transition-colors">Update profile →</a>
      </div>
    </div>

  </div>
</main>

<script>
async function acceptRequest(fromId) {
  const r = await fetch('/api/friends/accept', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ fromId }),
  });
  if (r.ok) {
    document.getElementById('req-' + fromId)?.remove();
    showToast('Friend request accepted!');
  }
}
async function rejectRequest(fromId) {
  const r = await fetch('/api/friends/reject', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ fromId }),
  });
  if (r.ok) {
    document.getElementById('req-' + fromId)?.remove();
    showToast('Request declined.');
  }
}
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}
</script>

<% } else { %>
<!-- ════════════════════════════════════════════════
     LANDING PAGE (logged out)
════════════════════════════════════════════════ -->
<main class="flex-1">

  <!-- Hero -->
  <section class="relative pt-28 pb-24 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-gold mb-6">Intelligent matchmaking</p>
          <h1 class="text-5xl lg:text-6xl font-serif font-bold text-charcoal leading-[1.08] mb-6 tracking-tight">
            Find a partner who <em class="text-gold not-italic">matches your soul</em>
          </h1>
          <p class="text-base text-text-muted leading-relaxed mb-10 max-w-md">
            Modern matchmaking for the ambitious and mindful. Real connections, verified profiles, no noise.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/signup" class="btn-primary" style="width:auto;padding:12px 28px;text-decoration:none;">Create free account</a>
            <a href="/discover" class="px-7 py-3 rounded-full border border-warm-border text-charcoal text-sm font-medium hover:border-gold hover:text-gold transition-all duration-200" style="text-decoration:none;">Browse profiles</a>
          </div>
        </div>

        <!-- Right visual -->
        <div class="relative hidden lg:block">
          <div class="aspect-[4/5] rounded-3xl overflow-hidden bg-blush">
            <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
              <rect width="400" height="500" fill="#F5EBE0"/>
              <!-- Abstract couple silhouette -->
              <circle cx="180" cy="170" r="55" fill="#E5D8C9"/>
              <circle cx="230" cy="185" r="50" fill="#DDD0C0"/>
              <ellipse cx="200" cy="380" rx="100" ry="80" fill="#E5D8C9"/>
              <!-- Heart -->
              <path d="M200 310 C200 310 160 285 160 260 C160 245 172 235 185 240 C192 243 200 252 200 252 C200 252 208 243 215 240 C228 235 240 245 240 260 C240 285 200 310 200 310Z" fill="#B8976A" opacity="0.6"/>
              <!-- Decorative rings -->
              <circle cx="330" cy="80" r="30" stroke="#B8976A" stroke-width="1" fill="none" opacity="0.3"/>
              <circle cx="70" cy="400" r="20" stroke="#B8976A" stroke-width="1" fill="none" opacity="0.3"/>
            </svg>
          </div>
          <!-- Floating card -->
          <div class="absolute bottom-8 -left-8 bg-white rounded-2xl p-5 shadow-soft-lg border border-warm-border/40 max-w-[200px]">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span class="text-[11px] font-semibold uppercase tracking-widest text-text-muted">Match Score</span>
            </div>
            <p class="text-2xl font-serif font-bold text-charcoal">98%</p>
            <p class="text-xs text-text-muted mt-1">Compatible</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-serif font-bold text-charcoal mb-3">Your journey starts here</h2>
      <p class="text-text-muted mb-14 max-w-xl mx-auto text-sm leading-relaxed">Three simple steps to a connection that actually matters.</p>
      <div class="grid md:grid-cols-3 gap-10">
        <div class="flex flex-col items-center">
          <div class="w-14 h-14 rounded-2xl bg-blush flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <h3 class="text-lg font-serif font-bold text-charcoal mb-2">Build your profile</h3>
          <p class="text-sm text-text-muted leading-relaxed">Share who you are — your values, passions, and what you're looking for.</p>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-14 h-14 rounded-2xl bg-blush flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"/>
            </svg>
          </div>
          <h3 class="text-lg font-serif font-bold text-charcoal mb-2">Discover & connect</h3>
          <p class="text-sm text-text-muted leading-relaxed">Browse real profiles and send friend requests to people you resonate with.</p>
        </div>
        <div class="flex flex-col items-center">
          <div class="w-14 h-14 rounded-2xl bg-blush flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <h3 class="text-lg font-serif font-bold text-charcoal mb-2">Chat in real time</h3>
          <p class="text-sm text-text-muted leading-relaxed">Once connected, chat instantly. No walls, no paywalls.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-4">
    <div class="max-w-3xl mx-auto bg-charcoal rounded-3xl p-14 text-center text-white relative overflow-hidden">
      <h2 class="text-4xl font-serif font-bold mb-5">Ready to find your equal?</h2>
      <p class="text-white/60 mb-9 text-sm leading-relaxed max-w-xl mx-auto">Join thousands of genuine people who chose quality over quantity.</p>
      <a href="/signup" class="inline-block bg-gold text-white px-9 py-3.5 rounded-full text-sm font-semibold hover:bg-gold-light transition-colors duration-200" style="text-decoration:none;">Get started — it's free</a>
    </div>
  </section>

</main>
<% } %>

<%- include('partials/footer') %>
<div id="toast"></div>

</body>
</html>
