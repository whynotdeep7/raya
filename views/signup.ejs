<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/header') %></head>
<body class="bg-ivory min-h-screen flex flex-col">
<main class="flex-1 flex items-center justify-center px-4 py-20">
  <div class="auth-card">

    <div class="text-center mb-8">
      <div class="inline-flex w-14 h-14 rounded-2xl bg-blush items-center justify-center mb-5">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <path d="M14 24.5C14 24.5 3.5 18.083 3.5 10.5C3.5 7.462 5.962 5 9 5C11.025 5 12.796 6.089 14 7.7C15.204 6.089 16.975 5 19 5C22.038 5 24.5 7.462 24.5 10.5C24.5 18.083 14 24.5 14 24.5Z" fill="#B8976A" fill-opacity="0.3" stroke="#B8976A" stroke-width="1.5"/>
        </svg>
      </div>
      <h1 class="text-3xl font-serif font-bold text-charcoal">Create your account</h1>
      <p class="text-text-muted text-sm mt-1.5">Start with your email — takes 30 seconds</p>
    </div>

    <!-- Step indicator -->
    <div class="flex items-center gap-2 mb-7">
      <div class="flex-1 h-1 rounded-full bg-charcoal"></div>
      <div class="flex-1 h-1 rounded-full bg-warm-border"></div>
      <span class="text-[11px] text-text-muted font-medium ml-1">Step 1 of 2</span>
    </div>

    <% if (error) { %>
      <div class="bg-red-50 text-red-600 px-4 py-3 rounded-xl text-sm mb-5 border border-red-100"><%= error %></div>
    <% } %>

    <form action="/signup" method="POST" class="space-y-5">
      <div>
        <label class="raya-label">Email address</label>
        <input type="email" name="email" required placeholder="you@example.com" class="raya-input">
      </div>
      <div>
        <label class="raya-label">Password</label>
        <input type="password" name="password" required placeholder="Minimum 6 characters" class="raya-input">
      </div>
      <div class="pt-1">
        <button type="submit" class="btn-primary">Continue</button>
      </div>
    </form>

    <div class="flex items-center gap-3 my-6">
      <div class="flex-1 h-px bg-warm-border"></div>
      <span class="text-xs text-text-muted">or</span>
      <div class="flex-1 h-px bg-warm-border"></div>
    </div>

    <a href="/auth/google" class="btn-google">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M17.64 9.205c0-.639-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615Z" fill="#4285F4"/>
        <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18Z" fill="#34A853"/>
        <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332Z" fill="#FBBC05"/>
        <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58Z" fill="#EA4335"/>
      </svg>
      Continue with Google
    </a>

    <p class="text-center text-sm text-text-muted mt-6">
      Already have an account? <a href="/login" class="text-gold font-medium hover:text-gold-dark transition-colors">Sign in</a>
    </p>
    <p class="text-center text-[11px] text-text-muted mt-3">
      By continuing you agree to our <a href="#" class="text-gold">Terms</a> &amp; <a href="#" class="text-gold">Privacy Policy</a>
    </p>
  </div>
</main>
<%- include('partials/footer') %>
</body>
</html>